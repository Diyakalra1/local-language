HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: custom origins for Socket.IO. If empty, ALLOWED_ORIGINS is used.
SOCKET_CORS_ORIGINS=

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Local development only
FIREBASE_CREDENTIALS_PATH=firebase-credentials-local-language.json

# Production (set one of these in your deploy platform)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_BASE64=
